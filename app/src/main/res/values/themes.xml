<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StopRKN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#3DDC97</item>
        <item name="colorPrimaryVariant">#1B3A2F</item>
        <item name="colorOnPrimary">#101412</item>
        <item name="colorSurface">#1A2420</item>
        <item name="colorOnSurface">#F2F5F3</item>
        <item name="android:statusBarColor">#101412</item>
        <item name="android:navigationBarColor">#101412</item>
        <item name="android:windowBackground">#101412</item>
        <item name="android:textColorPrimary">#F2F5F3</item>
        <item name="colorControlNormal">#F2F5F3</item>
        <item name="colorControlActivated">#3DDC97</item>
        <item name="android:colorControlNormal">#F2F5F3</item>
        <item name="android:colorControlActivated">#3DDC97</item>
        <item name="materialButtonStyle">@style/StopRKN.Button</item>
        <item name="android:buttonStyle">@style/StopRKN.Button</item>
        <item name="alertDialogTheme">@style/StopRKN.Dialog</item>
        <item name="materialAlertDialogTheme">@style/StopRKN.Dialog</item>
    </style>

    <style name="StopRKN.Button" parent="android:Widget.Button">
        <item name="android:textColor">#101412</item>
        <item name="android:background">#3DDC97</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="StopRKN.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">#1A2420</item>
        <item name="colorSurface">#1A2420</item>
        <item name="colorOnSurface">#F2F5F3</item>
        <item name="android:textColorPrimary">#F2F5F3</item>
        <item name="android:textColor">#F2F5F3</item>
        <item name="android:textColorAlertDialogListItem">#F2F5F3</item>
        <item name="textColorAlertDialogListItem">#F2F5F3</item>
        <item name="android:textColorSecondary">#B7C4BC</item>
        <item name="colorAccent">#3DDC97</item>
        <item name="buttonBarPositiveButtonStyle">@style/StopRKN.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/StopRKN.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/StopRKN.DialogButton</item>
        <item name="android:buttonBarButtonStyle">@style/StopRKN.DialogButton</item>
    </style>

    <style name="StopRKN.DialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#3DDC97</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
